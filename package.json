{
  "name": "@agegr/pi-web",
  "version": "0.9.3",
  "description": "Web UI for the pi coding agent",
  "homepage": "https://github.com/agegr/pi-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agegr/pi-web.git"
  },
  "bugs": {
    "url": "https://github.com/agegr/pi-web/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "pi-web": "bin/pi-web.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/**/*.mjs",
    "app/**/*.css",
    "app/**/*.ico",
    "components/**/*.ts",
    "components/**/*.tsx",
    "components/**/*.mjs",
    "components/**/*.css",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "hooks/**/*.mjs",
    "lib/**/*.ts",
    "lib/**/*.mjs",
    "lib/**/*.LICENSE",
    "plugins/**/*.ts",
    "plugins/**/*.mjs",
    "!plugins/**/.env*",
    "!app/**/.env*",
    "!components/**/.env*",
    "!hooks/**/.env*",
    "!lib/**/.env*",
    "instrumentation.ts",
    "instrumentation-node.ts",
    "proxy.ts",
    "next.config.ts",
    "postcss.config.mjs",
    "tailwind.config.ts",
    "tsconfig.json",
    "lib/ask-user.LICENSE",
    "lib/git-graph-layout.LICENSE",
    "package.json"
  ],
  "scripts": {
    "postinstall": "node bin/prepare-terminal.js",
    "dev": "node bin/next-cli.js dev -H 127.0.0.1 -p 30141",
    "dev:lan": "node bin/next-cli.js dev -H 0.0.0.0 -p 30141",
    "build": "next build --webpack",
    "start": "node bin/next-cli.js start -H 127.0.0.1 -p 30141",
    "start:lan": "node bin/next-cli.js start -H 0.0.0.0 -p 30141",
    "lint": "eslint .",
    "test:terminal": "nix run .#test -- e2e --group terminal",
    "test:e2e": "nix run .#test -- e2e",
    "test": "nix run .#test -- core",
    "release": "npm version patch --no-git-tag-version && npm run build && npm publish --access public"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@pierre/diffs": "1.5.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ansi_up": "^6.0.6",
    "js-yaml": "^5.4.3",
    "katex": "0.19.0",
    "mammoth": "^1.13.0",
    "mermaid": "^12.1.0",
    "next": "16.4.2",
    "node-pty": "1.2.0-beta.15",
    "proper-lockfile": "4.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-cjk-friendly": "2.3.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "semver": "7.8.5",
    "undici": "8.12.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdast": "4.0.4",
    "@types/node": "^24.19.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/semver": "7.8.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.2",
    "jiti": "^2.7.0",
    "playwright": "^1.64.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "katex": "$katex"
  }
}
